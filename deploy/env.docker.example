# Production environment for the workout-tracker stack on the home server.
# Copy to ~/apps/workout-tracker/.env on the server, edit the secrets, then:
#   chmod 600 ~/apps/workout-tracker/.env
#
# Read by the app (all of it), by docker compose (POSTGRES_PASSWORD for the
# postgres container and the ${TAG} interpolation), and ignored keys are simply
# not used by the other side. This file is NOT committed; keep secrets here.
#
# NOTE: the password in DATABASE_URL must be percent-encoded when it contains
# special characters, and it MUST match POSTGRES_PASSWORD (@ -> %40, / -> %2F).

# ---- app: server -----------------------------------------------------------
APP_ENV=production
HTTP_ADDR=127.0.0.1:8080

# ---- postgres container ----------------------------------------------------
# Password for the "workout" role; used on first start only.
POSTGRES_PASSWORD=CHANGE_ME

# ---- app: database ---------------------------------------------------------
DATABASE_URL=postgres://workout:CHANGE_ME@127.0.0.1:5432/workout?sslmode=disable
DB_MAX_CONNS=10

# ---- app: media ------------------------------------------------------------
MEDIA_DIR=/var/lib/workout-tracker/media
MEDIA_BASE_URL=https://kilo.faarihsan.com

# ---- app: proxy / auth / limits --------------------------------------------
# Only the host nginx (connecting over loopback) may set X-Forwarded-For.
TRUSTED_PROXY_CIDRS=127.0.0.1/32
TOKEN_TTL_DAYS=365

LOGIN_MAX_FAILS_USER=5
LOGIN_MAX_FAILS_IP=20
LOGIN_LOCK_MINUTES=15

# argon2id, tuned for ~100 ms per hash. Peak RAM ~ MAX_CONCURRENT x MEMORY_KIB.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=2
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENT=2

LOG_LEVEL=info
