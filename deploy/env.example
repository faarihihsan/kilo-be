# Environment for the workout-tracker server (docs/implementation-plan.md
# section 3). Copy to /etc/workout-tracker/env on the VPS, edit, then lock it:
#   install -o root -g root -m 600 deploy/env.example /etc/workout-tracker/env
#
# Format: systemd EnvironmentFile, one KEY=value per line, no `export`, no
# shell expansion, no trailing comments. A blank value counts as unset (except
# TRUSTED_PROXY_CIDRS, see below). Do not commit the real file.
# The server validates everything at startup and prints ALL problems at once.

# ---- Server (read by `server serve` and `server migrate up`) ----------------

# production | development. Unset means production. Development relaxes
# MEDIA_BASE_URL (optional, http:// allowed) and MEDIA_DIR (relative allowed).
APP_ENV=production

# Listen address. Keep it on localhost: Caddy is the only public entry point.
HTTP_ADDR=127.0.0.1:8080

# PostgreSQL connection URL (required). Contains the password, so this file
# must be chmod 600. Percent-encode special characters in the password
# (@ becomes %40, / becomes %2F). Use plain libpq parameters only: backup.sh
# passes this URL to pg_dump too, which rejects pgx-only parameters.
DATABASE_URL=postgres://workout:CHANGE_ME@127.0.0.1:5432/workout?sslmode=disable

# Size of the connection pool, 1 to 100. Keep it below Postgres max_connections
# (20 on the 2 GB VPS, see postgresql-tuning.conf).
DB_MAX_CONNS=10

# Directory for exercise images (required). Persistent and backed up. In
# production it must be an absolute path and must equal the `root` of the
# /media/* block in the Caddyfile and ReadWritePaths in the systemd unit.
MEDIA_DIR=/var/lib/workout-tracker/media

# Public prefix of image_url, no trailing slash (required in production, and
# there it must be https://). Change it when a CDN is added.
MEDIA_BASE_URL=https://api.example.com

# Comma-separated CIDRs (or bare IPs) that may set X-Forwarded-For; the client
# IP for rate limits is taken from it only when the TCP peer is in this list.
# Default 127.0.0.1/32 (Caddy on the same host). Set to an empty value to trust
# no proxy at all. 0.0.0.0/0 and ::/0 are rejected.
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Lifetime of a login token in days, 1 to 3650.
TOKEN_TTL_DAYS=365

# Brute-force limits for POST /v1/auth/login: failed attempts per username and
# per client IP in a 15 minute window before it is locked, and for how long
# (1 to 1440 minutes). While locked, even the right password gets 429.
LOGIN_MAX_FAILS_USER=5
LOGIN_MAX_FAILS_IP=20
LOGIN_LOCK_MINUTES=15

# argon2id password hashing. Tune so one hash takes about 100 ms on the VPS.
# Memory in KiB (at least 8192); 65536 = 64 MiB per hash.
ARGON2_MEMORY_KIB=65536
# Number of passes over the memory (at least 1).
ARGON2_TIME=2
# Lanes, 1 to 255.
ARGON2_PARALLELISM=1
# Hashes allowed to run at once. Peak RAM is about
# ARGON2_MAX_CONCURRENT x ARGON2_MEMORY_KIB, so 2 x 64 MiB = 128 MiB here.
ARGON2_MAX_CONCURRENT=2

# debug | info | warn | error
LOG_LEVEL=info

# ---- Backup (read only by deploy/backup.sh, ignored by the server) ----------
# backup.sh also uses DATABASE_URL and MEDIA_DIR from above. Set exactly one of
# BACKUP_RSYNC_TARGET or BACKUP_RCLONE_REMOTE: a backup that stays on the VPS
# dies with the VPS, so the script refuses to run without an off-box target.

# Local staging directory for the dumps; the service user must be able to write
# here (install -d -o workout -g workout -m 700 /var/backups/workout-tracker).
BACKUP_DIR=/var/backups/workout-tracker

# How many days of database dumps to keep, locally and at the target.
BACKUP_RETENTION_DAYS=14

# Option A: rsync over SSH to another machine. The directory must already exist;
# the script creates db/ and media/ inside it.
BACKUP_RSYNC_TARGET=backup@backup-host.example.com:/srv/backups/workout-tracker
# SSH private key for the target (no passphrase, readable by the service user).
# The host key must already be in that user's known_hosts.
BACKUP_SSH_KEY=/etc/workout-tracker/backup_ed25519

# Option B: an rclone remote:path (object storage). Configure the remote with
# `rclone config` and point RCLONE_CONFIG at the file (chmod 600).
# BACKUP_RCLONE_REMOTE=b2:my-bucket/workout-tracker
# RCLONE_CONFIG=/etc/workout-tracker/rclone.conf

# Optional: a URL pinged after every successful backup (healthchecks.io style),
# so a silently missing backup raises an alert.
# BACKUP_HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here
