# Local development environment for the workout-tracker server.
#
# Copy to .env and edit as needed:
#     cp .env.example .env
#
# The server loads .env at startup (set ENV_FILE to use another path), so
#     go build -o bin/server ./cmd/server && ./bin/server serve
# works without exporting anything. Real environment variables always take
# precedence over this file, so `make run` and systemd still win.
#
# .env is git-ignored; keep secrets out of .env.example.

# development relaxes MEDIA_DIR (relative allowed) and derives MEDIA_BASE_URL
# from HTTP_ADDR. Anything other than "development" is treated as production.
APP_ENV=development

HTTP_ADDR=127.0.0.1:8080

# The throwaway PostgreSQL from `make db-up` (docker-compose.test.yml), created
# and migrated by `make dev-db`.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/workout_dev?sslmode=disable

DB_MAX_CONNS=10

# Exercise images. Relative is fine in development; `make run` uses ./var/media.
MEDIA_DIR=./var/media

# Optional in development (defaults to http://<HTTP_ADDR>). Set it to test
# absolute image URLs.
# MEDIA_BASE_URL=http://127.0.0.1:8080

# Cheap argon2id so login/register are fast while developing.
ARGON2_MEMORY_KIB=8192
ARGON2_TIME=1

LOG_LEVEL=info
