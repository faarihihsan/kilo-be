# This project fetches Go modules from the public proxy, not the company
# Artifactory/Nexus mirror configured in the global Go env
# (~/Library/Application Support/go/env). direnv applies this only while you
# are inside this directory; other projects keep GOPROXY=artifactory.
#
# The global Go env also pins GOTOOLCHAIN=local, but go.mod requires go1.27.1
# while the local toolchain is older, so let Go download the pinned toolchain.
export GOPROXY="https://proxy.golang.org,direct"
export GOSUMDB="sum.golang.org"
export GOTOOLCHAIN="auto"
